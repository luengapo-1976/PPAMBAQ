# Variables de entorno del proyecto PPAM
# Copiar este archivo a .env (backend) y a environment.ts/environment.prod.ts (frontend, vía variables de build)
# Nunca commitear el archivo .env real ni exponer SUPABASE_SERVICE_ROLE_KEY al frontend.

# --- Backend (NestJS) ---
SUPABASE_URL=https://cssdcuzzmhnyubssqnnj.supabase.co
# Clave secreta con privilegios de administrador (bypassa RLS). Solo se usa en el backend.
# Generarla en el Dashboard de Supabase: Project Settings > API > service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar/verificar los JWT propios emitidos por NestJS
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Frontend (Angular) ---
# Clave pública, segura de exponer en el cliente (usada solo si el frontend habla directo
# con Supabase Auth/Storage; el resto de operaciones de negocio van vía API REST de NestJS).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNzc2RjdXp6bWhueXVic3Nxbm5qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5MjYzODMsImV4cCI6MjA5OTUwMjM4M30.5nZcYmF2NkQK0iHklRcUDCYz-IdJ1zC6oTJAQYALec8

